{
  "functions": {
    "src/app/api/photos/upload/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/galleries/[galleryId]/download/worker/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/scheduled-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/download-emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/resume-stuck-downloads",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/gallery-expiry-warning",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/expired-galleries",
      "schedule": "0 9 * * *"
    }
  ]
}
